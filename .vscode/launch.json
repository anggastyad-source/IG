{
  "version": "0.2.0",
  "configurations": [
    {
      // Start Live Server first ("Go Live" in the status bar), then press F5
      "name": "Debug in Chrome (Live Server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Debug in Chrome, offline worker on",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500/index.html?sw=1",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
